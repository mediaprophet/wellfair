@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix wf:   <https://wellfare.social/ns/vault#> .

# ═══════════════════════════════════════════════════════════════════════════════
# WellFair Vault — Access Profile Shapes
#
# Each profile is a sh:NodeShape that declares which data paths (sh:property)
# may be read during a session of that type.  Profiles are SHACL shapes rather
# than OWL classes so that they describe constraints on data access, not class
# membership of the natural person whose vault it is.
#
# New profiles can be defined by creating additional sh:NodeShape instances
# following the same pattern and adding them to the profile registry.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Data path vocabulary ──────────────────────────────────────────────────────
# Each property corresponds to a named section the vault can serve.

wf:overview          a rdf:Property ; rdfs:label "Overview & summary"@en .
wf:heartRate         a rdf:Property ; rdfs:label "Heart rate"@en .
wf:bloodPressure     a rdf:Property ; rdfs:label "Blood pressure"@en .
wf:sleep             a rdf:Property ; rdfs:label "Sleep"@en .
wf:steps             a rdf:Property ; rdfs:label "Activity & steps"@en .
wf:weight            a rdf:Property ; rdfs:label "Weight"@en .
wf:medications          a rdf:Property ; rdfs:label "Current medications"@en .
wf:medicationAdherence  a rdf:Property ; rdfs:label "Medication adherence log"@en ;
    rdfs:comment "Daily take/skip log. Clinical profiles only — not shared with emergency responders."@en .
wf:medicationHistory    a rdf:Property ; rdfs:label "Ceased / historical medications"@en .
wf:medicationInteractions a rdf:Property ; rdfs:label "Drug interaction alerts"@en ;
    rdfs:comment "Interaction alerts derived from current medication list and substance logs."@en .

# Pharmacological linked-data vocabulary (SPARQL endpoint references)
@prefix rxnorm: <http://purl.bioontology.org/ontology/RXNORM/> .
@prefix atc:    <http://purl.bioontology.org/ontology/ATC/> .
@prefix chembl: <http://rdf.ebi.ac.uk/terms/chembl#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix wdt:    <http://www.wikidata.org/prop/direct/> .

wf:rxcui          a rdf:Property ; rdfs:label "RxNorm CUI"@en ; rdfs:range xsd:string .
wf:atcCode        a rdf:Property ; rdfs:label "ATC classification code"@en ; rdfs:range xsd:string .
wf:linkedDataUri  a rdf:Property ; rdfs:label "Canonical linked-data URI for this substance"@en ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Wikidata or ChEMBL entity URI — enables pharmacological SPARQL queries without transmitting personal data."@en .
wf:scheduleTimes  a rdf:Property ; rdfs:label "Scheduled dose times (HH:MM, local)"@en .
wf:adherenceStatus a rdf:Property ; rdfs:label "Adherence status for a logged dose"@en ;
    rdfs:comment "One of: taken | skipped | late | unknown."@en .
wf:allergies         a rdf:Property ; rdfs:label "Allergies & adverse reactions"@en .
wf:conditions        a rdf:Property ; rdfs:label "Medical conditions"@en .
wf:bloodType         a rdf:Property ; rdfs:label "Blood type & Rh factor"@en .
wf:dnr               a rdf:Property ; rdfs:label "Advance directives & DNR status"@en .
wf:emergencyContacts a rdf:Property ; rdfs:label "Emergency contacts"@en .
wf:surgicalHistory   a rdf:Property ; rdfs:label "Surgical & procedure history"@en .
wf:mentalHealth      a rdf:Property ; rdfs:label "Mental health records"@en .
wf:sexualHealth      a rdf:Property ; rdfs:label "Sexual health & STI status"@en .
wf:socialContext     a rdf:Property ; rdfs:label "Social & housing context"@en .


# ── Access condition vocabulary ───────────────────────────────────────────────

wf:AccessCondition a rdfs:Class .

wf:NormalAccess
    a wf:AccessCondition ;
    rdfs:label "Normal"@en ;
    rdfs:comment "Vault owner is conscious and actively consenting to this session."@en .

wf:EmergencyAccess
    a wf:AccessCondition ;
    rdfs:label "Emergency"@en ;
    rdfs:comment "Vault owner may be unconscious or incapacitated. Pre-authorised by the owner when configuring this profile. Access is time-limited and fully audited."@en .


# ── Credential requirement vocabulary ────────────────────────────────────────

wf:CredentialType a rdfs:Class .

wf:NoCredentialRequired
    a wf:CredentialType ;
    rdfs:label "No credential required"@en ;
    rdfs:comment "Personal trust relationship — no verifiable credential needed."@en .

wf:PersonalTrustPin
    a wf:CredentialType ;
    rdfs:label "Shared PIN"@en ;
    rdfs:comment "A PIN the vault owner has shared with this person out-of-band."@en .

wf:EmergencyResponderVC
    a wf:CredentialType ;
    rdfs:label "Emergency responder credential (VC)"@en ;
    rdfs:comment "Verifiable Credential issued to a paramedic or first responder by their employer or registration body."@en .

wf:ClinicalProfessionalVC
    a wf:CredentialType ;
    rdfs:label "Clinical professional credential (VC)"@en ;
    rdfs:comment "Verifiable Credential from a medical registration body (e.g. GMC, NMC)."@en .

wf:MentalHealthPractitionerVC
    a wf:CredentialType ;
    rdfs:label "Mental health practitioner credential (VC)"@en ;
    rdfs:comment "Verifiable Credential from a mental health registration body."@en .

wf:SocialWorkerVC
    a wf:CredentialType ;
    rdfs:label "Social worker credential (VC)"@en ;
    rdfs:comment "Verifiable Credential from a social work registration body (e.g. Social Work England)."@en .


# ── Custom properties for profiles ───────────────────────────────────────────

wf:accessCondition    a rdf:Property ; rdfs:range wf:AccessCondition .
wf:credentialRequired a rdf:Property ; rdfs:range wf:CredentialType .
wf:sessionMaxDuration a rdf:Property ; rdfs:range xsd:duration ;
    rdfs:comment "Maximum wall-clock duration of a session under this profile."@en .
wf:requiresAudit      a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, all access events must be written to the vault's immutable audit log."@en .
wf:sessionScoped      a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, the vault owner manually selects exactly which sections to expose for this specific session rather than relying on the profile defaults."@en .
wf:uiColor            a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "Hex colour used to visually distinguish this profile in the vault UI."@en .
wf:uiIcon             a rdf:Property ; rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════════════
# PROFILE SHAPES
# ═══════════════════════════════════════════════════════════════════════════════


# ── Additional data path vocabulary for owner/document mode ──────────────────

wf:documents         a rdf:Property ; rdfs:label "Uploaded documents & PDFs"@en .
wf:notes             a rdf:Property ; rdfs:label "Personal notes & journal"@en .
wf:sanctuaryData     a rdf:Property ; rdfs:label "Sanctuary Mode records"@en .
wf:auditLog          a rdf:Property ; rdfs:label "Vault access audit log"@en .
wf:vaultSettings     a rdf:Property ; rdfs:label "Vault configuration & profiles"@en .

# ── Write access vocabulary ───────────────────────────────────────────────────

wf:AccessMode a rdfs:Class .
wf:ReadOnly  a wf:AccessMode ; rdfs:label "Read only"@en .
wf:ReadWrite a wf:AccessMode ; rdfs:label "Read and write"@en .

wf:accessMode a rdf:Property ; rdfs:range wf:AccessMode ;
    rdfs:comment "Whether the session may write data back to the vault."@en .

# ── Owner credential ──────────────────────────────────────────────────────────

wf:VaultOwnerPIN
    a wf:CredentialType ;
    rdfs:label "Vault owner PIN"@en ;
    rdfs:comment "PIN or biometric known only to the vault owner, verified locally on the phone."@en .


# ── Owner Workspace Profile ───────────────────────────────────────────────────

wf:OwnerWorkspaceProfile
    a sh:NodeShape ;
    rdfs:label      "Owner — Personal Workspace"@en ;
    rdfs:comment    "The vault owner using their desktop or laptop as an extension of their phone vault. Full read/write access to all sections. Authenticated by vault owner PIN or biometric on the phone. No credential is presented to a third party — this is the owner's own session."@en ;
    dct:description "Use case: owner processes documents, reviews full records, writes notes, configures profiles — all on a larger screen."@en ;
    wf:uiColor      "#1a1a2e" ;
    wf:uiIcon       "🔐" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:VaultOwnerPIN ;
    wf:accessMode         wf:ReadWrite ;
    wf:requiresAudit      false ;
    # All data paths available to the owner
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:heartRate              ] ;
    sh:property [ sh:path wf:bloodPressure          ] ;
    sh:property [ sh:path wf:sleep                  ] ;
    sh:property [ sh:path wf:steps                  ] ;
    sh:property [ sh:path wf:weight                 ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationAdherence    ] ;
    sh:property [ sh:path wf:medicationHistory      ] ;
    sh:property [ sh:path wf:medicationInteractions ] ;
    sh:property [ sh:path wf:allergies              ] ;
    sh:property [ sh:path wf:conditions             ] ;
    sh:property [ sh:path wf:bloodType              ] ;
    sh:property [ sh:path wf:dnr                    ] ;
    sh:property [ sh:path wf:emergencyContacts      ] ;
    sh:property [ sh:path wf:surgicalHistory        ] ;
    sh:property [ sh:path wf:mentalHealth           ] ;
    sh:property [ sh:path wf:sexualHealth           ] ;
    sh:property [ sh:path wf:socialContext          ] ;
    sh:property [ sh:path wf:documents              ] ;
    sh:property [ sh:path wf:notes                  ] ;
    sh:property [ sh:path wf:auditLog               ] ;
    sh:property [ sh:path wf:vaultSettings          ] .


# ── Emergency / First Responder ───────────────────────────────────────────────

wf:EmergencyFirstResponderProfile
    a sh:NodeShape ;
    rdfs:label      "Emergency / First Responder"@en ;
    rdfs:comment    "Paramedic, ambulance crew, or trained bystander. Accesses the minimum information needed to safely treat an unconscious or incapacitated person. Pre-authorised by the vault owner. Time-limited to 2 hours. All access permanently logged."@en ;
    dct:description "Use case: vault owner is unconscious at scene of incident."@en ;
    wf:uiColor      "#dc3545" ;
    wf:uiIcon       "🚑" ;
    wf:accessCondition    wf:EmergencyAccess ;
    wf:credentialRequired wf:EmergencyResponderVC ;
    wf:sessionMaxDuration "PT2H"^^xsd:duration ;
    wf:requiresAudit      true ;
    sh:property [ sh:path wf:allergies         ; sh:minCount 1 ; rdfs:label "Required"@en ] ;
    sh:property [ sh:path wf:bloodType         ; sh:minCount 1 ; rdfs:label "Required"@en ] ;
    sh:property [ sh:path wf:medications       ; sh:minCount 1 ; rdfs:label "Required"@en ] ;
    sh:property [ sh:path wf:conditions        ; sh:minCount 0 ] ;
    sh:property [ sh:path wf:dnr               ; sh:minCount 1 ; rdfs:label "Required"@en ] ;
    sh:property [ sh:path wf:emergencyContacts ; sh:minCount 1 ; rdfs:label "Required"@en ] .


# ── Emergency Department ──────────────────────────────────────────────────────

wf:EmergencyDepartmentProfile
    a sh:NodeShape ;
    rdfs:label      "Emergency Department (Clinical)"@en ;
    rdfs:comment    "ED clinician treating an incapacitated patient in hospital. Full clinical picture needed for safe treatment decisions including surgical history and implants."@en ;
    dct:description "Use case: vault owner admitted to ED, unable to consent."@en ;
    wf:uiColor      "#c0392b" ;
    wf:uiIcon       "🏥" ;
    wf:accessCondition    wf:EmergencyAccess ;
    wf:credentialRequired wf:ClinicalProfessionalVC ;
    wf:sessionMaxDuration "PT4H"^^xsd:duration ;
    wf:requiresAudit      true ;
    sh:property [ sh:path wf:overview          ] ;
    sh:property [ sh:path wf:allergies         ] ;
    sh:property [ sh:path wf:bloodType         ] ;
    sh:property [ sh:path wf:medications       ] ;
    sh:property [ sh:path wf:conditions        ] ;
    sh:property [ sh:path wf:dnr               ] ;
    sh:property [ sh:path wf:emergencyContacts ] ;
    sh:property [ sh:path wf:surgicalHistory   ] .


# ── General Practitioner ──────────────────────────────────────────────────────

wf:GeneralPractitionerProfile
    a sh:NodeShape ;
    rdfs:label      "General Practitioner"@en ;
    rdfs:comment    "Primary care physician. General health vitals, medications, and chronic conditions. Mental health and sexual health are excluded from this profile by default — those require explicit opt-in by the vault owner."@en ;
    wf:uiColor      "#0d6efd" ;
    wf:uiIcon       "👨‍⚕️" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:ClinicalProfessionalVC ;
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:heartRate              ] ;
    sh:property [ sh:path wf:bloodPressure          ] ;
    sh:property [ sh:path wf:sleep                  ] ;
    sh:property [ sh:path wf:steps                  ] ;
    sh:property [ sh:path wf:weight                 ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationAdherence    ] ;
    sh:property [ sh:path wf:medicationHistory      ] ;
    sh:property [ sh:path wf:medicationInteractions ] ;
    sh:property [ sh:path wf:allergies              ] ;
    sh:property [ sh:path wf:conditions             ] .


# ── Specialist ────────────────────────────────────────────────────────────────

wf:SpecialistProfile
    a sh:NodeShape ;
    rdfs:label      "Specialist"@en ;
    rdfs:comment    "Hospital specialist (cardiologist, oncologist, etc.). Clinical vitals, medications, and procedure history. Sub-profiles for specific specialties can extend this base shape."@en ;
    wf:uiColor      "#6610f2" ;
    wf:uiIcon       "🔬" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:ClinicalProfessionalVC ;
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:heartRate              ] ;
    sh:property [ sh:path wf:bloodPressure          ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationAdherence    ] ;
    sh:property [ sh:path wf:medicationHistory      ] ;
    sh:property [ sh:path wf:medicationInteractions ] ;
    sh:property [ sh:path wf:allergies              ] ;
    sh:property [ sh:path wf:conditions             ] ;
    sh:property [ sh:path wf:surgicalHistory        ] .


# ── Psychiatrist / Mental Health Clinician ────────────────────────────────────

wf:PsychiatristProfile
    a sh:NodeShape ;
    rdfs:label      "Psychiatrist / Mental Health Clinician"@en ;
    rdfs:comment    "Mental health practitioner. Accesses psychiatric history, sleep, and psychiatric medications. Substance use data is excluded — that lives in Sanctuary Mode and requires explicit separate disclosure."@en ;
    wf:uiColor      "#6f42c1" ;
    wf:uiIcon       "🧠" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:MentalHealthPractitionerVC ;
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:mentalHealth           ] ;
    sh:property [ sh:path wf:sleep                  ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationAdherence    ] ;
    sh:property [ sh:path wf:medicationInteractions ] .


# ── Social Worker ─────────────────────────────────────────────────────────────

wf:SocialWorkerProfile
    a sh:NodeShape ;
    rdfs:label      "Social Worker"@en ;
    rdfs:comment    "Social care professional. Social and housing context, support network, and emergency contacts. No clinical data by default — clinical detail is out of scope for social care unless explicitly added."@en ;
    wf:uiColor      "#198754" ;
    wf:uiIcon       "🤝" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:SocialWorkerVC ;
    sh:property [ sh:path wf:overview          ] ;
    sh:property [ sh:path wf:socialContext     ] ;
    sh:property [ sh:path wf:emergencyContacts ] .


# ── Personal / Partner ────────────────────────────────────────────────────────

wf:PersonalPartnerProfile
    a sh:NodeShape ;
    rdfs:label      "Personal / Partner"@en ;
    rdfs:comment    "Intimate or close personal sharing. Sexual health status and most recent STI screening date only, by default. The vault owner can optionally add general health overview. No credential required — this is a personal trust relationship."@en ;
    wf:uiColor      "#e91e63" ;
    wf:uiIcon       "❤️" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:NoCredentialRequired ;
    sh:property [ sh:path wf:sexualHealth ] .


# ── Carer / Family ────────────────────────────────────────────────────────────

wf:CarerFamilyProfile
    a sh:NodeShape ;
    rdfs:label      "Carer / Family Member"@en ;
    rdfs:comment    "Trusted carer or family member supporting day-to-day welfare. Overview, medications, conditions, allergies, and emergency contacts. Mental health records are excluded unless the vault owner explicitly adds them."@en ;
    wf:uiColor      "#fd7e14" ;
    wf:uiIcon       "🏠" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:NoCredentialRequired ;
    sh:property [ sh:path wf:overview          ] ;
    sh:property [ sh:path wf:medications       ] ;
    sh:property [ sh:path wf:conditions        ] ;
    sh:property [ sh:path wf:allergies         ] ;
    sh:property [ sh:path wf:emergencyContacts ] .


# ── Legal Advocate / Solicitor ────────────────────────────────────────────────

wf:LegalAdvocateProfile
    a sh:NodeShape ;
    rdfs:label      "Legal Advocate / Solicitor"@en ;
    rdfs:comment    "Legal professional acting on the vault owner's behalf. Fully session-scoped: the vault owner selects exactly which records to share for the specific legal matter. The profile provides no default access — all sections are opt-in per session."@en ;
    wf:uiColor      "#6c757d" ;
    wf:uiIcon       "⚖️" ;
    wf:accessCondition    wf:NormalAccess ;
    wf:credentialRequired wf:PersonalTrustPin ;
    wf:sessionScoped      true ;
    # No sh:property entries — all sections opt-in per session
    .


# ═══════════════════════════════════════════════════════════════════════════════
# VC-7 — Verified Directory: Contact Graph Data Vocabulary & Shapes
#
# Classes and properties for the contact graph stored in IDB wf-contacts,
# wf-relationships, and wf-agreements. All records about people use SHACL
# shapes rather than OWL class membership (architecture rule 3).
# ═══════════════════════════════════════════════════════════════════════════════


# ── Directory class vocabulary ────────────────────────────────────────────────

wf:Contact
    a rdfs:Class ;
    rdfs:label   "Contact"@en ;
    rdfs:comment "A person in the vault owner's Verified Directory. Stored encrypted in IDB wf-contacts."@en .

wf:Relationship
    a rdfs:Class ;
    rdfs:label   "Relationship edge"@en ;
    rdfs:comment "A directed relationship between the vault owner and a Contact, backed by a signed UsageAgreement. Stored encrypted in IDB wf-relationships."@en .

wf:UsageAgreement
    a rdfs:Class ;
    rdfs:label   "Signed usage agreement"@en ;
    rdfs:comment "An ODRL Agreement signed by both parties governing data sharing permissions. Stored encrypted in IDB wf-agreements."@en .


# ── Contact properties ────────────────────────────────────────────────────────

wf:contactDid
    a rdf:Property ;
    rdfs:domain wf:Contact ;
    rdfs:range  xsd:string ;
    rdfs:label  "Identity credential identifier (did:key or did:peer)"@en ;
    rdfs:comment "The contact's identity credential — a did:key for ephemeral sessions or a did:peer for an established relationship channel."@en .

wf:contactWebId
    a rdf:Property ;
    rdfs:domain wf:Contact ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "WebID or profile URL"@en .

wf:contactNymAddress
    a rdf:Property ;
    rdfs:domain wf:Contact ;
    rdfs:range  xsd:string ;
    rdfs:label  "Nym mixnet address"@en ;
    rdfs:comment "Contact's Nym mixnet address for anonymous routing via the nymAdapter."@en .

wf:contactNotes
    a rdf:Property ;
    rdfs:domain wf:Contact ;
    rdfs:range  xsd:string ;
    rdfs:label  "Private notes"@en ;
    rdfs:comment "Vault-owner private notes about this contact. Encrypted at rest."@en .


# ── Relationship properties ───────────────────────────────────────────────────

wf:relationshipType
    a rdf:Property ;
    rdfs:domain wf:Relationship ;
    rdfs:label  "Relationship category"@en ;
    rdfs:comment "One of: personal | professional | clinical | legal."@en .

wf:peerDid
    a rdf:Property ;
    rdfs:domain wf:Relationship ;
    rdfs:range  xsd:string ;
    rdfs:label  "did:peer for this relationship channel"@en ;
    rdfs:comment "Per-relationship did:peer generated during the Semantic Handshake (VC-8)."@en .

wf:agreementRef
    a rdf:Property ;
    rdfs:domain wf:Relationship ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "UsageAgreement reference"@en ;
    rdfs:comment "Pointer to the wf:UsageAgreement record governing this relationship."@en .


# ── UsageAgreement properties ─────────────────────────────────────────────────

wf:agreementOdrl
    a rdf:Property ;
    rdfs:domain wf:UsageAgreement ;
    rdfs:range  xsd:string ;
    rdfs:label  "ODRL Agreement JSON-LD"@en ;
    rdfs:comment "Full ODRL Agreement serialised as a JSON-LD string."@en .

wf:agreementSig
    a rdf:Property ;
    rdfs:domain wf:UsageAgreement ;
    rdfs:range  xsd:string ;
    rdfs:label  "Initiator Ed25519 signature"@en ;
    rdfs:comment "Base64 Ed25519 signature over canonical agreement JSON, signed by the initiator."@en .

wf:counterpartySig
    a rdf:Property ;
    rdfs:domain wf:UsageAgreement ;
    rdfs:range  xsd:string ;
    rdfs:label  "Counterparty Ed25519 signature"@en ;
    rdfs:comment "Counterparty's Base64 Ed25519 signature over canonical agreement JSON."@en .


# ── SHACL NodeShapes for directory records ────────────────────────────────────

wf:callProfileId
    a rdf:Property ;
    rdfs:domain wf:Contact ;
    rdfs:range  xsd:string ;
    rdfs:label  "Call profile identifier"@en ;
    rdfs:comment "ID of the wf:CallProfile shape that governs which vault sections are surfaced in the call overlay Info panel when a video call is active with this contact. Defaults to 'generic_call'."@en .

wf:ContactShape
    a sh:NodeShape ;
    sh:targetClass wf:Contact ;
    rdfs:label     "Contact record shape"@en ;
    rdfs:comment   "Validates a wf:Contact record — the plaintext form stored encrypted in IDB wf-contacts."@en ;
    sh:property [
        sh:path     wf:contactDid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        rdfs:label  "Required: identity credential identifier"@en ;
    ] ;
    sh:property [
        sh:path     wf:contactWebId ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:contactNymAddress ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:contactNotes ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:callProfileId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:defaultValue "generic_call" ;
    ] .


wf:RelationshipShape
    a sh:NodeShape ;
    sh:targetClass wf:Relationship ;
    rdfs:label     "Relationship edge shape"@en ;
    rdfs:comment   "Validates a wf:Relationship record stored encrypted in IDB wf-relationships."@en ;
    sh:property [
        sh:path     wf:relationshipType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "personal" "professional" "clinical" "legal" ) ;
    ] ;
    sh:property [
        sh:path     wf:peerDid ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:agreementRef ;
        sh:maxCount 1 ;
    ] .


wf:UsageAgreementShape
    a sh:NodeShape ;
    sh:targetClass wf:UsageAgreement ;
    rdfs:label     "Usage agreement shape"@en ;
    rdfs:comment   "Validates a wf:UsageAgreement record stored encrypted in IDB wf-agreements."@en ;
    sh:property [
        sh:path     wf:agreementOdrl ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:agreementSig ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:counterpartySig ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .


# ═══════════════════════════════════════════════════════════════════════════════
# VC-10 — Call Profiles: per-contact data-sharing presets for video calls
#
# A CallProfile is attached to a Contact record (wf:callProfileId) and governs
# which vault sections are surfaced in the call overlay Info panel during an
# active call with that contact. Unlike access profiles (which govern what a
# connector session may read), call profiles are suggestions to the vault owner
# about what they might want to share — the owner always remains in control.
#
# Safe default: wf:GenericCallProfile — no sections offered.
# ═══════════════════════════════════════════════════════════════════════════════


wf:CallProfile
    a rdfs:Class ;
    rdfs:subClassOf sh:NodeShape ;
    rdfs:label   "Call profile"@en ;
    rdfs:comment "A data-sharing preset attached to a directory contact. Determines which vault sections are highlighted in the call overlay Info panel. Not a restriction — the vault owner may always share any section manually."@en .

wf:callProfileType
    a rdf:Property ;
    rdfs:domain wf:CallProfile ;
    rdfs:range  xsd:string ;
    rdfs:label  "Call profile type identifier"@en .


# ── Generic call (no health data) ────────────────────────────────────────────

wf:GenericCallProfile
    a wf:CallProfile ;
    wf:callProfileType "generic_call" ;
    rdfs:label   "General call"@en ;
    rdfs:comment "Standard video or audio call. No health data sections are offered by default. Suitable for friends, work colleagues, or any contact who does not need health information."@en ;
    wf:uiIcon    "📞" ;
    wf:uiColor   "#6c757d" .


# ── Health consultation ───────────────────────────────────────────────────────

wf:HealthConsultationCallProfile
    a wf:CallProfile ;
    wf:callProfileType "health_consultation" ;
    rdfs:label   "Health consultation"@en ;
    rdfs:comment "GP, nurse, or primary care provider. Overview, current medications, conditions, vitals, and allergies are surfaced for sharing."@en ;
    wf:uiIcon    "🩺" ;
    wf:uiColor   "#0d6efd" ;
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:heartRate              ] ;
    sh:property [ sh:path wf:bloodPressure          ] ;
    sh:property [ sh:path wf:weight                 ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationAdherence    ] ;
    sh:property [ sh:path wf:medicationInteractions ] ;
    sh:property [ sh:path wf:allergies              ] ;
    sh:property [ sh:path wf:conditions             ] .


# ── Mental health session ─────────────────────────────────────────────────────

wf:MentalHealthCallProfile
    a wf:CallProfile ;
    wf:callProfileType "mental_health_call" ;
    rdfs:label   "Mental health session"@en ;
    rdfs:comment "Psychologist, counsellor, or mental health support worker. Mental health records, sleep patterns, and psychiatric medications surfaced."@en ;
    wf:uiIcon    "🧠" ;
    wf:uiColor   "#6f42c1" ;
    sh:property [ sh:path wf:overview            ] ;
    sh:property [ sh:path wf:mentalHealth        ] ;
    sh:property [ sh:path wf:sleep               ] ;
    sh:property [ sh:path wf:medications         ] ;
    sh:property [ sh:path wf:medicationAdherence ] .


# ── Social work check-in ──────────────────────────────────────────────────────

wf:SocialWorkCallProfile
    a wf:CallProfile ;
    wf:callProfileType "social_work_call" ;
    rdfs:label   "Social work check-in"@en ;
    rdfs:comment "Social worker, case manager, or community support worker. Social and housing context and emergency contacts surfaced. No clinical data."@en ;
    wf:uiIcon    "🤝" ;
    wf:uiColor   "#198754" ;
    sh:property [ sh:path wf:overview          ] ;
    sh:property [ sh:path wf:socialContext     ] ;
    sh:property [ sh:path wf:emergencyContacts ] .


# ── Specialist consultation ───────────────────────────────────────────────────

wf:SpecialistCallProfile
    a wf:CallProfile ;
    wf:callProfileType "specialist_call" ;
    rdfs:label   "Specialist consultation"@en ;
    rdfs:comment "Hospital specialist (cardiologist, oncologist, etc.). Full clinical picture including medication interactions, conditions, and surgical history."@en ;
    wf:uiIcon    "🔬" ;
    wf:uiColor   "#6610f2" ;
    sh:property [ sh:path wf:overview               ] ;
    sh:property [ sh:path wf:heartRate              ] ;
    sh:property [ sh:path wf:bloodPressure          ] ;
    sh:property [ sh:path wf:medications            ] ;
    sh:property [ sh:path wf:medicationHistory      ] ;
    sh:property [ sh:path wf:medicationInteractions ] ;
    sh:property [ sh:path wf:allergies              ] ;
    sh:property [ sh:path wf:conditions             ] ;
    sh:property [ sh:path wf:surgicalHistory        ] .


# ── Carer / family call ───────────────────────────────────────────────────────

wf:CarerCallProfile
    a wf:CallProfile ;
    wf:callProfileType "carer_call" ;
    rdfs:label   "Carer / family call"@en ;
    rdfs:comment "Trusted carer or family member. Overview, medications, conditions, allergies, and emergency contacts surfaced."@en ;
    wf:uiIcon    "🏠" ;
    wf:uiColor   "#fd7e14" ;
    sh:property [ sh:path wf:overview          ] ;
    sh:property [ sh:path wf:medications       ] ;
    sh:property [ sh:path wf:conditions        ] ;
    sh:property [ sh:path wf:allergies         ] ;
    sh:property [ sh:path wf:emergencyContacts ] .


# ── Legal consultation ────────────────────────────────────────────────────────

wf:LegalCallProfile
    a wf:CallProfile ;
    wf:callProfileType "legal_call" ;
    rdfs:label   "Legal consultation"@en ;
    rdfs:comment "Legal representative or advocate. No sections surfaced by default — the vault owner selects exactly what evidence or context to share for this specific legal matter."@en ;
    wf:uiIcon    "⚖️" ;
    wf:uiColor   "#6c757d" .


# ── Crisis support ────────────────────────────────────────────────────────────

wf:CrisisSupportCallProfile
    a wf:CallProfile ;
    wf:callProfileType "crisis_support_call" ;
    rdfs:label   "Crisis support"@en ;
    rdfs:comment "Crisis support worker (e.g. Beyond Blue, Lifeline, domestic violence service). Social context, emergency contacts, and mental health sections surfaced. Designed for situations where the vault owner needs immediate practical or safety support."@en ;
    wf:uiIcon    "🆘" ;
    wf:uiColor   "#dc3545" ;
    sh:property [ sh:path wf:socialContext     ] ;
    sh:property [ sh:path wf:emergencyContacts ] ;
    sh:property [ sh:path wf:mentalHealth      ] .


# ═══════════════════════════════════════════════════════════════════════════════
# PIA1 — Cooperative Projects: qp: Vocabulary & SHACL Shapes
#
# qp: prefix → https://qualia.id/ns/ (same namespace as qualia: in
# qualiaDB/docs/manuals/qualia_shapes.ttl; qp: is the WellFair convention).
# Spec: https://github.com/mediaprophet/qualiaDB/blob/main/docs/protocol-integration-architecture.md
#
# wf: ↔ qp: alignment — entities are dual-typed in vault-projects.js so that
# SPARQL queries over WasmHealthStore can use either vocabulary:
#
#   wf:CooperativeProject  ↔  qp:Workspace
#   wf:ContributionRecord  ↔  qp:ProvenanceCommit  (Merkle chain entry)
#   wf:ObligationBalance   ↔  qp:EffortObligation  (µ-unit balance)
#   wf:UsageAgreement      ↔  qp:Contract
#   wf:authorDid           ↔  qp:authorNym
#   wf:prevHash            ↔  qp:antecedent
#   wf:muUnits             ↔  qp:amount
#   wf:agreementRef        ↔  qp:hasConsentRelation
#   wf:coContributor (DIR1) ↔  qp:hasMember
# ═══════════════════════════════════════════════════════════════════════════════

@prefix qp: <https://qualia.id/ns/> .


# ── qp: Class vocabulary ──────────────────────────────────────────────────────

qp:Workspace
    a rdfs:Class ;
    rdfs:subClassOf wf:CooperativeProject ;
    rdfs:label   "Cooperative Workspace"@en ;
    rdfs:comment "A shared cooperative project space. Dual-typed with wf:CooperativeProject in vault-projects.js Turtle export."@en .

qp:EffortObligation
    a rdfs:Class ;
    rdfs:label   "Effort Obligation"@en ;
    rdfs:comment "A contributor's current obligation balance in a cooperative project (µ-units). Dual-typed with wf:ObligationBalance."@en .

qp:ProvenanceCommit
    a rdfs:Class ;
    rdfs:label   "Provenance Commit"@en ;
    rdfs:comment "A cryptographically chained contribution record. Every commit links to its antecedent (no orphans). Dual-typed with wf:ContributionRecord."@en .

qp:Contract
    a rdfs:Class ;
    rdfs:subClassOf wf:UsageAgreement ;
    rdfs:label   "Cooperative Contract"@en ;
    rdfs:comment "A signed cooperative agreement between two or more participant DIDs. Dual-typed with wf:UsageAgreement."@en .

qp:VerifiableClaim
    a rdfs:Class ;
    rdfs:label   "Verifiable Claim"@en ;
    rdfs:comment "A signed claim about contribution, equity eligibility, or audit state within a cooperative project."@en .

qp:Slice
    a rdfs:Class ;
    rdfs:label   "Equity Slice"@en ;
    rdfs:comment "A contributor's Dynamic Equity / Stewardship Share allocation expressed as qp:equityPercent (0–100 %). Planned store: wf-shares or extended wf-obligations (CP7)."@en .

qp:TokenizedShare
    a rdfs:Class ;
    rdfs:subClassOf qp:Slice ;
    rdfs:label   "Tokenized Share"@en ;
    rdfs:comment "A qp:Slice that has been tokenized. Cash-out subject to qp:ProjectGovernance.allowsCashOut."@en .

qp:ProjectGovernance
    a rdfs:Class ;
    rdfs:label   "Project Governance"@en ;
    rdfs:comment "Governance rules for a cooperative project: decision model, cash-out eligibility, tokenization policy. Stored in wf-projects (CP8)."@en .


# ── qp: Property vocabulary ───────────────────────────────────────────────────

qp:hasMember
    a rdf:Property ;
    rdfs:domain qp:Workspace ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "has member (did:key IRI)"@en ;
    rdfs:comment "Cooperative project participant DID. Aligns with wf:coContributor relationship type (DIR1)."@en .

qp:antecedent
    a rdf:Property ;
    rdfs:domain qp:ProvenanceCommit ;
    rdfs:range  xsd:string ;
    rdfs:label  "antecedent (Merkle link)"@en ;
    rdfs:comment "Base64 SHA-256 hash of the previous commit in the Merkle chain. Aligns with wf:prevHash."@en .

qp:authorNym
    a rdf:Property ;
    rdfs:domain qp:ProvenanceCommit ;
    rdfs:range  xsd:string ;
    rdfs:label  "author Nym / did:key"@en ;
    rdfs:comment "Identifier of the contributor who authored this commit. Aligns with wf:authorDid."@en .

qp:amount
    a rdf:Property ;
    rdfs:domain qp:EffortObligation ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "obligation amount (µ-units)"@en ;
    rdfs:comment "Non-negative obligation value. Aligns with wf:muUnits."@en .

qp:provenance
    a rdf:Property ;
    rdfs:domain qp:EffortObligation ;
    rdfs:label  "provenance commit"@en ;
    rdfs:comment "Reference to the qp:ProvenanceCommit that last updated this obligation balance."@en .

qp:hasConsentRelation
    a rdf:Property ;
    rdfs:range  wf:UsageAgreement ;
    rdfs:label  "has consent relation"@en ;
    rdfs:comment "Links any entity to the wf:UsageAgreement (ODRL agreement) governing its outbound data flows. Aligns with wf:agreementRef. All cross-project data flows must carry this property (PIA8)."@en .

qp:contributor
    a rdf:Property ;
    rdfs:domain qp:Slice ;
    rdfs:range  xsd:string ;
    rdfs:label  "contributor did:key"@en .

qp:equityPercent
    a rdf:Property ;
    rdfs:domain qp:Slice ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "equity allocation (%)"@en ;
    rdfs:comment "Percentage of project equity allocated to this contributor (0–100)."@en .

qp:vestingStart
    a rdf:Property ;
    rdfs:domain qp:Slice ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "vesting start date"@en .

qp:tokenized
    a rdf:Property ;
    rdfs:domain qp:Slice ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "is tokenized"@en .

qp:allowsCashOut
    a rdf:Property ;
    rdfs:domain qp:ProjectGovernance ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "allows cash-out"@en ;
    rdfs:comment "Whether this project permits converting µ-units / equity to Lightning payments via the HCW rail."@en .

qp:decisionModel
    a rdf:Property ;
    rdfs:domain qp:ProjectGovernance ;
    rdfs:range  xsd:string ;
    rdfs:label  "decision model"@en ;
    rdfs:comment "One of: majority | consensus | steward | founder."@en .

qp:tokenizationEnabled
    a rdf:Property ;
    rdfs:domain qp:ProjectGovernance ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "tokenization enabled"@en .

qp:cashOutThreshold
    a rdf:Property ;
    rdfs:domain qp:ProjectGovernance ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "minimum µ-units for cash-out"@en ;
    rdfs:comment "Minimum accumulated µ-units before a cash-out can be initiated."@en .

qp:governedBy
    a rdf:Property ;
    rdfs:domain qp:Workspace ;
    rdfs:range  qp:ProjectGovernance ;
    rdfs:label  "governed by"@en .

qp:party
    a rdf:Property ;
    rdfs:domain qp:Contract ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "contract party (did:key IRI)"@en ;
    rdfs:comment "A participant DID that is a signatory of this contract. Minimum 2 per qp:Contract."@en .

qp:claimType
    a rdf:Property ;
    rdfs:domain qp:VerifiableClaim ;
    rdfs:range  xsd:string ;
    rdfs:label  "claim type"@en ;
    rdfs:comment "One of: contribution | equity | eligibility | audit."@en .


# ── SHACL NodeShapes for wf:/qp: cooperative entities ────────────────────────

wf:CooperativeProjectShape
    a sh:NodeShape ;
    sh:targetClass wf:CooperativeProject ;
    rdfs:label   "Cooperative Project shape"@en ;
    rdfs:comment "Validates a wf-projects IDB record. Dual-typed as qp:Workspace in Turtle export."@en ;
    sh:property [
        sh:path     wf:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:ratePerHour ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:joinedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .

wf:ContributionRecordShape
    a sh:NodeShape ;
    sh:targetClass wf:ContributionRecord ;
    rdfs:label   "Contribution record shape"@en ;
    rdfs:comment "Validates a wf-contributions IDB record. Dual-typed as qp:ProvenanceCommit in Turtle export."@en ;
    sh:property [
        sh:path     wf:project ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:hours ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:merkleHash ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:antecedent ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:authorNym ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

wf:ObligationBalanceShape
    a sh:NodeShape ;
    sh:targetClass wf:ObligationBalance ;
    rdfs:label   "Obligation balance shape"@en ;
    rdfs:comment "Validates a wf-obligations IDB record. Dual-typed as qp:EffortObligation in Turtle export."@en ;
    sh:property [
        sh:path     wf:totalHours ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:muUnits ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:amount ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] .

qp:SliceShape
    a sh:NodeShape ;
    sh:targetClass qp:Slice ;
    rdfs:label   "Equity Slice shape"@en ;
    rdfs:comment "Validates a Dynamic Equity / Stewardship Share record (planned store: wf-shares or extended wf-obligations, CP7)."@en ;
    sh:property [
        sh:path     qp:contributor ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:equityPercent ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 100 ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:tokenized ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] .

qp:ProjectGovernanceShape
    a sh:NodeShape ;
    sh:targetClass qp:ProjectGovernance ;
    rdfs:label   "Project Governance shape"@en ;
    rdfs:comment "Validates a governance rules record stored in wf-projects (CP8)."@en ;
    sh:property [
        sh:path     qp:allowsCashOut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:decisionModel ;
        sh:datatype xsd:string ;
        sh:in       ( "majority" "consensus" "steward" "founder" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:tokenizationEnabled ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     qp:cashOutThreshold ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] .

qp:ContractShape
    a sh:NodeShape ;
    sh:targetClass qp:Contract ;
    rdfs:label   "Cooperative Contract shape"@en ;
    rdfs:comment "Validates a qp:Contract (extends wf:UsageAgreementShape with multi-party constraints)."@en ;
    sh:property [
        sh:path     qp:party ;
        sh:nodeKind sh:IRI ;
        sh:minCount 2 ;
        sh:message  "A cooperative contract must have at least two signing parties."@en ;
    ] ;
    sh:property [
        sh:path     wf:agreementOdrl ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path     wf:agreementSig ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .


# ═══════════════════════════════════════════════════════════════════════════════
# PIA2 — Protocol Session Event Schema
#
# Every protocol-level event (WebRTC call, GUN sync, WebTorrent swarm, git commit)
# produces a wf:ProtocolEvent record written to the wf-events IDB store and
# dual-written as a Q42 quint via the existing dual-write hook in vault-idb.js.
#
# Event types (wf:protocolEventType values):
#   "webrtc_session_start"  — call initiated; participants, consent basis recorded
#   "webrtc_session_end"    — call ended; duration computed
#   "gun_sync_checkpoint"   — GUN graph sync completed; entity count recorded
#   "webtorrent_swarm_join" — joined a P2P swarm; infoHash, consent ref recorded
#   "webtorrent_seed_start" — began seeding an asset; requires qp:hasConsentRelation
#   "git_commit_ref"        — git-compatible signed commit object created (PIA10)
#   "qp_boundary_conflict"  — project tried to schedule over personal priority time (PIA6)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Protocol event class & properties ────────────────────────────────────────

wf:ProtocolEvent
    a rdfs:Class ;
    rdfs:label   "Protocol Event"@en ;
    rdfs:comment "A provenance record for a protocol-level session or sync event. Written to wf-events IDB and dual-written as a Q42 quint."@en .

wf:protocolEventType
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "protocol event type"@en ;
    rdfs:comment "One of: webrtc_session_start | webrtc_session_end | gun_sync_checkpoint | webtorrent_swarm_join | webtorrent_seed_start | git_commit_ref | qp_boundary_conflict."@en .

wf:sessionParticipants
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "session participants (did:key list, JSON)"@en .

wf:sessionDurationSeconds
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "session duration (seconds)"@en .

wf:consentBasis
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "consent basis (agreement URI)"@en ;
    rdfs:comment "Reference to the wf:UsageAgreement (qp:hasConsentRelation) that authorised this event."@en .

wf:swarmInfoHash
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "WebTorrent swarm info-hash"@en .

wf:entityCount
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:integer ;
    rdfs:label  "entity count (e.g. GUN graph node count)"@en .

wf:gitCommitHash
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "Ed25519-signed git commit hash"@en .

wf:conflictWindow
    a rdf:Property ;
    rdfs:domain wf:ProtocolEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "conflict window (ISO 8601 interval)"@en ;
    rdfs:comment "The personal-priority time window that a project attempted to schedule over (qp_boundary_conflict events)."@en .


# ── SHACL shape for wf:ProtocolEvent ─────────────────────────────────────────

wf:ProtocolEventShape
    a sh:NodeShape ;
    sh:targetClass wf:ProtocolEvent ;
    rdfs:label   "Protocol Event shape"@en ;
    rdfs:comment "Validates a protocol provenance record in wf-events IDB."@en ;
    sh:property [
        sh:path     wf:protocolEventType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "webrtc_session_start" "webrtc_session_end"
                      "gun_sync_checkpoint"
                      "webtorrent_swarm_join" "webtorrent_seed_start"
                      "git_commit_ref"
                      "qp_boundary_conflict" ) ;
    ] ;
    sh:property [
        sh:path     wf:consentBasis ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     dcterms:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
